    {
      "example_num": 1,
      "example_text": "Input: path = \"NES\"\nOutput: false \nExplanation: Notice that the path doesn't cross any point more than once.",
      "images": [
        "https://assets.leetcode.com/uploads/2020/06/10/screen-shot-2020-06-10-at-123929-pm.png"
      ]
    },
    {
