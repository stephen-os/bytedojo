        "https://assets.leetcode.com/uploads/2019/11/28/matrix.png"
      ]
    }
  ],
  "constraints": [
    "m == mat.length",
    "n == mat[i].length",
    "1 <= m, n <= 3",
    "mat[i][j] is either 0 or 1."
