      "images": []
    },
    {
      "example_num": 2,
      "example_text": "Input: s = \"abb\"\nOutput: 2\nExplanation: \"abb\" -> \"bb\" -> \"\". \nRemove palindromic subsequence \"a\" then \"bb\".",
