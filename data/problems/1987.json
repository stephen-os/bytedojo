      "images": []
    },
    {
      "example_num": 2,
      "example_text": "Input: binary = \"11\"\nOutput: 2\nExplanation: The good subsequences of binary are [\"1\", \"1\", \"11\"].\nThe unique good subsequences are \"1\" and \"11\".",
