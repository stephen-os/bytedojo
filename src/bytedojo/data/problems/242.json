{
  "id": 242,
  "title": "Valid Anagram",
  "slug": "valid-anagram",
  "difficulty": "Easy",
  "description": "Given two strings s and t, return true if t is an anagram of s, and false otherwise.\nFollow up: What if the inputs contain Unicode characters? How would you adapt your solution to such a case?",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: s = \"anagram\", t = \"nagaram\"\nOutput: true"
    },
    {
      "example_num": 2,
      "example_text": "Input: s = \"rat\", t = \"car\"\nOutput: false"
    }
  ],
  "constraints": [
    "1 <= s.length, t.length <= 5 * 104",
    "s and t consist of lowercase English letters."
  ],
  "hints": [],
  "tags": [
    "hash-table",
    "string",
    "sorting"
  ],
  "signature": {
    "params": [
      {
        "name": "s",
        "type": {
          "base": "STRING"
        }
      },
      {
        "name": "t",
        "type": {
          "base": "STRING"
        }
      }
    ],
    "returns": {
      "base": "BOOL"
    }
  }
}
