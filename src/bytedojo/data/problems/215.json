    {
      "example_num": 1,
      "example_text": "Input: nums = [3,2,1,5,6,4], k = 2\nOutput: 5"
    },
    {
      "example_num": 2,
      "example_text": "Input: nums = [3,2,3,1,2,4,5,5,6], k = 4\nOutput: 4"
    }
  ],
  "constraints": [
    "1 <= k <= nums.length <= 105",
    "-104 <= nums[i] <= 104"
