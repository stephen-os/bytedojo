  "title": "Nth Magical Number",
  "slug": "nth-magical-number",
  "difficulty": "Hard",
  "description": "A positive integer is magical if it is divisible by either a or b.\nGiven the three integers n, a, and b, return the nth magical number. Since the answer may be very large, return it modulo 109 + 7.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: n = 1, a = 2, b = 3\nOutput: 2"
    },
    {
      "example_num": 2,
      "example_text": "Input: n = 4, a = 2, b = 3\nOutput: 6"
    }
  ],
  "constraints": [
    "1 <= n <= 109",
    "2 <= a, b <= 4 * 104"
  ],
