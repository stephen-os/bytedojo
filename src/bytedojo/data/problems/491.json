{
  "id": 491,
  "title": "Non-decreasing Subsequences",
  "slug": "non-decreasing-subsequences",
  "difficulty": "Medium",
  "description": "Given an integer array nums, return all the different possible non-decreasing subsequences of the given array with at least two elements. You may return the answer in any order.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: nums = [4,6,7,7]\nOutput: [[4,6],[4,6,7],[4,6,7,7],[4,7],[4,7,7],[6,7],[6,7,7],[7,7]]"
    },
    {
      "example_num": 2,
      "example_text": "Input: nums = [4,4,3,2,1]\nOutput: [[4,4]]"
    }
  ],
  "constraints": [
    "1 <= nums.length <= 15",
    "-100 <= nums[i] <= 100"
  ],
  "hints": [],
  "tags": [
    "array",
    "hash-table",
    "backtracking",
    "bit-manipulation"
  ],
  "signature": {
    "params": [
      {
        "name": "nums",
        "type": {
          "base": "ARRAY",
          "element": "INT32"
        }
      }
    ],
    "returns": {
      "base": "MATRIX",
      "element": "INT32"
    }
  }
}
