    },
    {
      "example_num": 4,
      "example_text": "Input: head = [1,2,3]\nOutput: [2,1,3]"
    }
  ],
  "constraints": [
    "The number of nodes in the list is in the range [0, 100].",
    "0 <= Node.val <= 100"
