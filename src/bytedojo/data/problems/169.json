{
  "id": 169,
  "title": "Majority Element",
  "slug": "majority-element",
  "difficulty": "Easy",
  "description": "Given an array nums of size n, return the majority element.\nThe majority element is the element that appears more than ⌊n / 2⌋ times. You may assume that the majority element always exists in the array.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: nums = [3,2,3]\nOutput: 3"
    },
    {
      "example_num": 2,
      "example_text": "Input: nums = [2,2,1,1,1,2,2]\nOutput: 2"
    }
  ],
  "constraints": [
    "n == nums.length",
    "1 <= n <= 5 * 104",
    "-109 <= nums[i] <= 109"
  ],
  "hints": [],
  "tags": [
    "array",
    "hash-table",
    "divide-and-conquer",
    "sorting",
    "counting"
  ],
  "signature": {
    "params": [
      {
        "name": "nums",
        "type": {
          "base": "ARRAY",
          "element": "INT32"
        }
      }
    ],
    "returns": {
      "base": "INT32"
    }
  }
}
