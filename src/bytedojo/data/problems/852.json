  "difficulty": "Medium",
  "description": "You are given an integer mountain array arr of length n where the values increase to a peak element and then decrease.\nReturn the index of the peak element.\nYour task is to solve it in O(log(n)) time complexity.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: arr = [0,1,0]\nOutput: 1"
    },
    {
      "example_num": 2,
      "example_text": "Input: arr = [0,2,1,0]\nOutput: 1"
    },
    {
      "example_num": 3,
      "example_text": "Input: arr = [0,10,5,2]\nOutput: 1"
    }
  ],
  "constraints": [
    "3 <= arr.length <= 105",
    "0 <= arr[i] <= 106",
    "arr is guaranteed to be a mountain array."
  ],
