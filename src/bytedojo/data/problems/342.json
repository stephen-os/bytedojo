  "title": "Power of Four",
  "slug": "power-of-four",
  "difficulty": "Easy",
  "description": "Given an integer n, return true if it is a power of four. Otherwise, return false.\nAn integer n is a power of four, if there exists an integer x such that n == 4x.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: n = 16\nOutput: true"
    },
    {
      "example_num": 2,
      "example_text": "Input: n = 5\nOutput: false"
    },
    {
      "example_num": 3,
      "example_text": "Input: n = 1\nOutput: true"
    }
  ],
  "constraints": [
    "-231 <= n <= 231 - 1"
  ],
