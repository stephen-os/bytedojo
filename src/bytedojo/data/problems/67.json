  "difficulty": "Easy",
  "description": "Given two binary strings a and b, return their sum as a binary string.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: a = \"11\", b = \"1\"\nOutput: \"100\""
    },
    {
      "example_num": 2,
      "example_text": "Input: a = \"1010\", b = \"1011\"\nOutput: \"10101\""
    }
  ],
  "constraints": [
    "1 <= a.length, b.length <= 104",
