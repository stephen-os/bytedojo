{
  "id": 90,
  "title": "Subsets II",
  "slug": "subsets-ii",
  "difficulty": "Medium",
  "description": "Given an integer array nums that may contain duplicates, return all possible subsets (the power set).\nThe solution set must not contain duplicate subsets. Return the solution in any order.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: nums = [1,2,2]\nOutput: [[],[1],[1,2],[1,2,2],[2],[2,2]]"
    },
    {
      "example_num": 2,
      "example_text": "Input: nums = [0]\nOutput: [[],[0]]"
    }
  ],
  "constraints": [
    "1 <= nums.length <= 10",
    "-10 <= nums[i] <= 10"
  ],
  "hints": [],
  "tags": [
    "array",
    "backtracking",
    "bit-manipulation"
  ],
  "signature": {
    "params": [
      {
        "name": "nums",
        "type": {
          "base": "ARRAY",
          "element": "INT32"
        }
      }
    ],
    "returns": {
      "base": "MATRIX",
      "element": "INT32"
    }
  }
}
