{
  "id": 1556,
  "title": "Thousand Separator",
  "slug": "thousand-separator",
  "difficulty": "Easy",
  "description": "Given an integer n, add a dot (\".\") as the thousands separator and return it in string format.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: n = 987\nOutput: \"987\""
    },
    {
      "example_num": 2,
      "example_text": "Input: n = 1234\nOutput: \"1.234\""
    }
  ],
  "constraints": [
    "0 <= n <= 231 - 1"
  ],
  "hints": [
    "Scan from the back of the integer and use dots to connect blocks with length 3 except the last block."
  ],
  "tags": [
    "string"
  ],
  "signature": {
    "params": [
      {
        "name": "n",
        "type": {
          "base": "INT32"
        }
      }
    ],
    "returns": {
      "base": "STRING"
    }
  }
}
