{
  "id": 970,
  "title": "Powerful Integers",
  "slug": "powerful-integers",
  "difficulty": "Medium",
  "description": "Given three integers x, y, and bound, return a list of all the powerful integers that have a value less than or equal to bound.\nAn integer is powerful if it can be represented as xi + yj for some integers i >= 0 and j >= 0.\nYou may return the answer in any order. In your answer, each value should occur at most once.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: x = 2, y = 3, bound = 10\nOutput: [2,3,4,5,7,9,10]\nExplanation:\n2 = 20 + 30\n3 = 21 + 30\n4 = 20 + 31\n5 = 21 + 31\n7 = 22 + 31\n9 = 23 + 30\n10 = 20 + 32"
    },
    {
      "example_num": 2,
      "example_text": "Input: x = 3, y = 5, bound = 15\nOutput: [2,4,6,8,10,14]"
    }
  ],
  "constraints": [
    "1 <= x, y <= 100",
    "0 <= bound <= 106"
  ],
  "hints": [],
  "tags": [
    "hash-table",
    "math",
    "enumeration"
  ],
  "signature": {
    "params": [
      {
        "name": "x",
        "type": {
          "base": "INT32"
        }
      },
      {
        "name": "y",
        "type": {
          "base": "INT32"
        }
      },
      {
        "name": "bound",
        "type": {
          "base": "INT32"
        }
      }
    ],
