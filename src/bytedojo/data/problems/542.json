{
  "id": 542,
  "title": "01 Matrix",
  "slug": "01-matrix",
  "difficulty": "Medium",
  "description": "Given an m x n binary matrix mat, return the distance of the nearest 0 for each cell.\nThe distance between two cells sharing a common edge is 1.\nNote: This question is the same as 1765: https://leetcode.com/problems/map-of-highest-peak/",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: mat = [[0,0,0],[0,1,0],[0,0,0]]\nOutput: [[0,0,0],[0,1,0],[0,0,0]]"
    },
    {
      "example_num": 2,
      "example_text": "Input: mat = [[0,0,0],[0,1,0],[1,1,1]]\nOutput: [[0,0,0],[0,1,0],[1,2,1]]"
    }
  ],
  "constraints": [
    "m == mat.length",
    "n == mat[i].length",
    "1 <= m, n <= 104",
    "1 <= m * n <= 104",
    "mat[i][j] is either 0 or 1.",
    "There is at least one 0 in mat."
  ],
  "hints": [],
  "tags": [
    "array",
    "dynamic-programming",
    "breadth-first-search",
    "matrix"
  ],
  "signature": {
    "params": [
      {
        "name": "mat",
        "type": {
          "base": "MATRIX",
          "element": "INT32"
        }
      }
    ],
    "returns": {
      "base": "MATRIX",
      "element": "INT32"
    }
  }
}
