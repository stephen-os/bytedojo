      "example_text": "Input: n = 16\nOutput: true\nExplanation: 24 = 16"
    },
    {
      "example_num": 3,
      "example_text": "Input: n = 3\nOutput: false"
    }
  ],
  "constraints": [
    "-231 <= n <= 231 - 1"
  ],
