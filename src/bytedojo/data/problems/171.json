{
  "id": 171,
  "title": "Excel Sheet Column Number",
  "slug": "excel-sheet-column-number",
  "difficulty": "Easy",
  "description": "Given a string columnTitle that represents the column title as appears in an Excel sheet, return its corresponding column number.\nFor example:",
  "examples": [
    {
      "example_num": 1,
      "example_text": "A -> 1\nB -> 2\nC -> 3\n...\nZ -> 26\nAA -> 27\nAB -> 28 \n..."
    },
    {
      "example_num": 2,
      "example_text": "Input: columnTitle = \"A\"\nOutput: 1"
    },
    {
      "example_num": 3,
      "example_text": "Input: columnTitle = \"AB\"\nOutput: 28"
    },
    {
      "example_num": 4,
      "example_text": "Input: columnTitle = \"ZY\"\nOutput: 701"
    }
  ],
  "constraints": [
    "1 <= columnTitle.length <= 7",
    "columnTitle consists only of uppercase English letters.",
    "columnTitle is in the range [\"A\", \"FXSHRXW\"]."
  ],
  "hints": [],
  "tags": [
    "math",
    "string"
  ],
  "signature": {
    "params": [
      {
        "name": "columnTitle",
        "type": {
          "base": "STRING"
        }
      }
    ],
    "returns": {
      "base": "INT32"
    }
  }
}
