{
  "id": 107,
  "title": "Binary Tree Level Order Traversal II",
  "slug": "binary-tree-level-order-traversal-ii",
  "difficulty": "Medium",
  "description": "Given the root of a binary tree, return the bottom-up level order traversal of its nodes' values. (i.e., from left to right, level by level from leaf to root).",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: root = [3,9,20,null,null,15,7]\nOutput: [[15,7],[9,20],[3]]"
    },
    {
      "example_num": 2,
      "example_text": "Input: root = [1]\nOutput: [[1]]"
    },
    {
      "example_num": 3,
      "example_text": "Input: root = []\nOutput: []"
    }
  ],
  "constraints": [
    "The number of nodes in the tree is in the range [0, 2000].",
    "-1000 <= Node.val <= 1000"
  ],
  "hints": [],
  "tags": [
    "tree",
    "breadth-first-search",
    "binary-tree"
  ],
  "signature": {
    "params": [
      {
        "name": "root",
        "type": {
          "base": "BINARY_TREE"
        }
      }
    ],
    "returns": {
      "base": "MATRIX",
      "element": "INT32"
    }
  }
}
