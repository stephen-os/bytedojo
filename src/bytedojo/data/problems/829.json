  "title": "Consecutive Numbers Sum",
  "slug": "consecutive-numbers-sum",
  "difficulty": "Hard",
  "description": "Given an integer n, return the number of ways you can write n as the sum of consecutive positive integers.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: n = 5\nOutput: 2\nExplanation: 5 = 2 + 3"
    },
    {
      "example_num": 2,
      "example_text": "Input: n = 9\nOutput: 3\nExplanation: 9 = 4 + 5 = 2 + 3 + 4"
    },
    {
      "example_num": 3,
      "example_text": "Input: n = 15\nOutput: 4\nExplanation: 15 = 8 + 7 = 4 + 5 + 6 = 1 + 2 + 3 + 4 + 5"
    }
  ],
  "constraints": [
    "1 <= n <= 109"
  ],
