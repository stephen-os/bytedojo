  "title": "Diagonal Traverse",
  "slug": "diagonal-traverse",
  "difficulty": "Medium",
  "description": "Given an m x n matrix mat, return an array of all the elements of the array in a diagonal order.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: mat = [[1,2,3],[4,5,6],[7,8,9]]\nOutput: [1,2,4,7,5,3,6,8,9]"
    },
    {
      "example_num": 2,
      "example_text": "Input: mat = [[1,2],[3,4]]\nOutput: [1,2,3,4]"
    }
  ],
  "constraints": [
    "m == mat.length",
    "n == mat[i].length",
    "1 <= m, n <= 104",
    "1 <= m * n <= 104",
    "-105 <= mat[i][j] <= 105"
  ],
