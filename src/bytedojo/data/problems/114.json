{
  "id": 114,
  "title": "Flatten Binary Tree to Linked List",
  "slug": "flatten-binary-tree-to-linked-list",
  "difficulty": "Medium",
  "description": "Given the root of a binary tree, flatten the tree into a \"linked list\":",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: root = [1,2,5,3,4,null,6]\nOutput: [1,null,2,null,3,null,4,null,5,null,6]"
    },
    {
      "example_num": 2,
      "example_text": "Input: root = []\nOutput: []"
    },
    {
      "example_num": 3,
      "example_text": "Input: root = [0]\nOutput: [0]"
    }
  ],
  "constraints": [
    "The number of nodes in the tree is in the range [0, 2000].",
    "-100 <= Node.val <= 100"
  ],
  "hints": [
    "If you notice carefully in the flattened tree, each node's right child points to the next node of a pre-order traversal."
  ],
  "tags": [
    "linked-list",
    "stack",
    "tree",
    "depth-first-search",
    "binary-tree"
  ],
  "signature": {
    "params": [
      {
        "name": "root",
        "type": {
          "base": "BINARY_TREE"
        }
      }
    ],
    "returns": {
      "base": "VOID"
    }
  }
}
