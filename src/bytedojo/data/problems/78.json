{
  "id": 78,
  "title": "Subsets",
  "slug": "subsets",
  "difficulty": "Medium",
  "description": "Given an integer array nums of unique elements, return all possible subsets (the power set).\nThe solution set must not contain duplicate subsets. Return the solution in any order.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: nums = [1,2,3]\nOutput: [[],[1],[2],[1,2],[3],[1,3],[2,3],[1,2,3]]"
    },
    {
      "example_num": 2,
      "example_text": "Input: nums = [0]\nOutput: [[],[0]]"
    }
  ],
  "constraints": [
    "1 <= nums.length <= 10",
    "-10 <= nums[i] <= 10",
    "All the numbers of nums are unique."
  ],
  "hints": [],
  "tags": [
    "array",
    "backtracking",
    "bit-manipulation"
  ],
  "signature": {
    "params": [
      {
        "name": "nums",
        "type": {
          "base": "ARRAY",
          "element": "INT32"
        }
      }
    ],
    "returns": {
      "base": "MATRIX",
      "element": "INT32"
    }
  }
}
