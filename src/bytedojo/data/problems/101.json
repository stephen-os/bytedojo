{
  "id": 101,
  "title": "Symmetric Tree",
  "slug": "symmetric-tree",
  "difficulty": "Easy",
  "description": "Given the root of a binary tree, check whether it is a mirror of itself (i.e., symmetric around its center).",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: root = [1,2,2,3,4,4,3]\nOutput: true"
    },
    {
      "example_num": 2,
      "example_text": "Input: root = [1,2,2,null,3,null,3]\nOutput: false"
    }
  ],
  "constraints": [
    "The number of nodes in the tree is in the range [1, 1000].",
    "-100 <= Node.val <= 100"
  ],
  "hints": [],
  "tags": [
    "tree",
    "depth-first-search",
    "breadth-first-search",
    "binary-tree"
  ],
  "signature": {
    "params": [
      {
        "name": "root",
        "type": {
          "base": "BINARY_TREE"
        }
      }
    ],
    "returns": {
      "base": "BOOL"
    }
  }
}
