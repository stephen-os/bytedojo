{
  "id": 179,
  "title": "Largest Number",
  "slug": "largest-number",
  "difficulty": "Medium",
  "description": "Given a list of non-negative integers nums, arrange them such that they form the largest number and return it.\nSince the result may be very large, so you need to return a string instead of an integer.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: nums = [10,2]\nOutput: \"210\""
    },
    {
      "example_num": 2,
      "example_text": "Input: nums = [3,30,34,5,9]\nOutput: \"9534330\""
    }
  ],
  "constraints": [
    "1 <= nums.length <= 100",
    "0 <= nums[i] <= 109"
  ],
  "hints": [],
  "tags": [
    "array",
    "string",
    "greedy",
    "sorting"
  ],
  "signature": {
    "params": [
      {
        "name": "nums",
        "type": {
          "base": "ARRAY",
          "element": "INT32"
        }
      }
    ],
    "returns": {
      "base": "STRING"
    }
  }
