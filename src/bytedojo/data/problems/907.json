{
  "id": 907,
  "title": "Sum of Subarray Minimums",
  "slug": "sum-of-subarray-minimums",
  "difficulty": "Medium",
  "description": "Given an array of integers arr, find the sum of min(b), where b ranges over every (contiguous) subarray of arr. Since the answer may be large, return the answer modulo 109 + 7.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: arr = [3,1,2,4]\nOutput: 17\nExplanation: \nSubarrays are [3], [1], [2], [4], [3,1], [1,2], [2,4], [3,1,2], [1,2,4], [3,1,2,4]. \nMinimums are 3, 1, 2, 4, 1, 1, 2, 1, 1, 1.\nSum is 17."
    },
    {
      "example_num": 2,
      "example_text": "Input: arr = [11,81,94,43,3]\nOutput: 444"
    }
  ],
  "constraints": [
    "1 <= arr.length <= 3 * 104",
    "1 <= arr[i] <= 3 * 104"
  ],
  "hints": [],
  "tags": [
    "array",
    "dynamic-programming",
    "stack",
    "monotonic-stack"
  ],
  "signature": {
    "params": [
      {
        "name": "arr",
        "type": {
          "base": "ARRAY",
          "element": "INT32"
        }
      }
    ],
    "returns": {
      "base": "INT32"
    }
  }
