{
  "id": 386,
  "title": "Lexicographical Numbers",
  "slug": "lexicographical-numbers",
  "difficulty": "Medium",
  "description": "Given an integer n, return all the numbers in the range [1, n] sorted in lexicographical order.\nYou must write an algorithm that runs in O(n) time and uses O(1) extra space.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: n = 13\nOutput: [1,10,11,12,13,2,3,4,5,6,7,8,9]"
    },
    {
      "example_num": 2,
      "example_text": "Input: n = 2\nOutput: [1,2]"
    }
  ],
  "constraints": [
    "1 <= n <= 5 * 104"
  ],
  "hints": [],
  "tags": [
    "depth-first-search",
    "trie"
  ],
  "signature": {
    "params": [
      {
        "name": "n",
        "type": {
          "base": "INT32"
        }
      }
    ],
    "returns": {
      "base": "ARRAY",
      "element": "INT32"
    }
  }
}
