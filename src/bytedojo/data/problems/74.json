{
  "id": 74,
  "title": "Search a 2D Matrix",
  "slug": "search-a-2d-matrix",
  "difficulty": "Medium",
  "description": "You are given an m x n integer matrix matrix with the following two properties:\nGiven an integer target, return true if target is in matrix or false otherwise.\nYou must write a solution in O(log(m * n)) time complexity.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: matrix = [[1,3,5,7],[10,11,16,20],[23,30,34,60]], target = 3\nOutput: true"
    },
    {
      "example_num": 2,
      "example_text": "Input: matrix = [[1,3,5,7],[10,11,16,20],[23,30,34,60]], target = 13\nOutput: false"
    }
  ],
  "constraints": [
    "m == matrix.length",
    "n == matrix[i].length",
    "1 <= m, n <= 100",
    "-104 <= matrix[i][j], target <= 104"
  ],
  "hints": [],
  "tags": [
    "array",
    "binary-search",
    "matrix"
  ],
  "signature": {
    "params": [
      {
        "name": "matrix",
        "type": {
          "base": "MATRIX",
          "element": "INT32"
        }
      },
      {
        "name": "target",
        "type": {
          "base": "INT32"
        }
      }
    ],
    "returns": {
      "base": "BOOL"
    }
  }
}
