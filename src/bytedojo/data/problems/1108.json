{
  "id": 1108,
  "title": "Defanging an IP Address",
  "slug": "defanging-an-ip-address",
  "difficulty": "Easy",
  "description": "Given a valid (IPv4) IP address, return a defanged version of that IP address.\nA defanged IP address replaces every period \".\" with \"[.]\".",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: address = \"1.1.1.1\"\r\nOutput: \"1[.]1[.]1[.]1\""
    },
    {
      "example_num": 2,
      "example_text": "Input: address = \"255.100.50.0\"\r\nOutput: \"255[.]100[.]50[.]0\""
    }
  ],
  "constraints": [
    "The given address is a valid IPv4 address."
  ],
  "hints": [],
  "tags": [
    "string"
  ],
  "signature": {
    "params": [
      {
        "name": "address",
        "type": {
          "base": "STRING"
        }
      }
    ],
    "returns": {
      "base": "STRING"
    }
  }
}
