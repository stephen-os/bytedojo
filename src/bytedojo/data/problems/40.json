{
  "id": 40,
  "title": "Combination Sum II",
  "slug": "combination-sum-ii",
  "difficulty": "Medium",
  "description": "Given a collection of candidate numbers (candidates) and a target number (target), find all unique combinations in candidates where the candidate numbers sum to target.\nEach number in candidates may only be used once in the combination.\nNote: The solution set must not contain duplicate combinations.",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: candidates = [10,1,2,7,6,1,5], target = 8\nOutput: \n[\n[1,1,6],\n[1,2,5],\n[1,7],\n[2,6]\n]"
    },
    {
      "example_num": 2,
      "example_text": "Input: candidates = [2,5,2,1,2], target = 5\nOutput: \n[\n[1,2,2],\n[5]\n]"
    }
  ],
  "constraints": [
    "1 <= candidates.length <= 100",
    "1 <= candidates[i] <= 50",
    "1 <= target <= 30"
  ],
  "hints": [],
  "tags": [
    "array",
    "backtracking"
  ],
  "signature": {
    "params": [
      {
        "name": "candidates",
        "type": {
          "base": "ARRAY",
          "element": "INT32"
        }
      },
      {
        "name": "target",
        "type": {
          "base": "INT32"
        }
      }
    ],
    "returns": {
      "base": "MATRIX",
      "element": "INT32"
    }
  }
}
