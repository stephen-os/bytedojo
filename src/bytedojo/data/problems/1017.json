{
  "id": 1017,
  "title": "Convert to Base -2",
  "slug": "convert-to-base-2",
  "difficulty": "Medium",
  "description": "Given an integer n, return a binary string representing its representation in base -2.\nNote that the returned string should not have leading zeros unless the string is \"0\".",
  "examples": [
    {
      "example_num": 1,
      "example_text": "Input: n = 2\nOutput: \"110\"\nExplantion: (-2)2 + (-2)1 = 2"
    },
    {
      "example_num": 2,
      "example_text": "Input: n = 3\nOutput: \"111\"\nExplantion: (-2)2 + (-2)1 + (-2)0 = 3"
    },
    {
      "example_num": 3,
      "example_text": "Input: n = 4\nOutput: \"100\"\nExplantion: (-2)2 = 4"
    }
  ],
  "constraints": [
    "0 <= n <= 109"
  ],
  "hints": [
    "Figure out whether you need the ones digit placed or not, then shift by two."
  ],
  "tags": [
    "math"
  ],
  "signature": {
    "params": [
      {
        "name": "n",
        "type": {
          "base": "INT32"
        }
      }
    ],
    "returns": {
      "base": "STRING"
    }
  }
}
