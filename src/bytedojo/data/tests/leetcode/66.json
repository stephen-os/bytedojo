{
  "problem_id": 66,
  "title": "Plus One",
  "difficulty": "Easy",
  "tests": [
    {"input": [[1, 2, 3]], "expected": [1, 2, 4]},
    {"input": [[4, 3, 2, 1]], "expected": [4, 3, 2, 2]},
    {"input": [[9]], "expected": [1, 0]},
    {"input": [[0]], "expected": [1]},
    {"input": [[9, 9]], "expected": [1, 0, 0]},
    {"input": [[9, 9, 9]], "expected": [1, 0, 0, 0]},
    {"input": [[1, 9, 9]], "expected": [2, 0, 0]},
    {"input": [[8, 9, 9, 9]], "expected": [9, 0, 0, 0]},
    {"input": [[1, 0, 0, 0]], "expected": [1, 0, 0, 1]},
    {"input": [[5]], "expected": [6]},
    {"input": [[1, 2, 9]], "expected": [1, 3, 0]},
    {"input": [[2, 9, 9, 9]], "expected": [3, 0, 0, 0]},
    {"input": [[7, 8, 9]], "expected": [7, 9, 0]},
    {"input": [[1, 0, 9]], "expected": [1, 1, 0]},
    {"input": [[9, 8, 7, 6, 5, 4, 3, 2, 1, 0]], "expected": [9, 8, 7, 6, 5, 4, 3, 2, 1, 1]}
  ]
