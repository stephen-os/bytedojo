{
  "problem_id": 2,
  "title": "Add Two Numbers",
  "difficulty": "Medium",
  "tests": [
    {"input": [[2, 4, 3], [5, 6, 4]], "expected": [7, 0, 8]},
    {"input": [[0], [0]], "expected": [0]},
    {"input": [[9, 9, 9, 9, 9, 9, 9], [9, 9, 9, 9]], "expected": [8, 9, 9, 9, 0, 0, 0, 1]},
    {"input": [[1], [9, 9, 9]], "expected": [0, 0, 0, 1]},
    {"input": [[5], [5]], "expected": [0, 1]},
    {"input": [[1, 2, 3], [4, 5, 6]], "expected": [5, 7, 9]},
    {"input": [[9], [1]], "expected": [0, 1]},
    {"input": [[0, 0, 1], [0, 0, 2]], "expected": [0, 0, 3]},
    {"input": [[1, 8], [0]], "expected": [1, 8]},
    {"input": [[9, 9], [1]], "expected": [0, 0, 1]},
    {"input": [[2, 4, 9], [5, 6, 4, 9]], "expected": [7, 0, 4, 0, 1]},
    {"input": [[1, 0, 0, 0, 0, 1], [5, 6, 4]], "expected": [6, 6, 4, 0, 0, 1]},
    {"input": [[0, 1], [0, 1, 2]], "expected": [0, 2, 2]},
    {"input": [[9, 9, 9], [9, 9, 9]], "expected": [8, 9, 9, 1]},
    {"input": [[1], [1]], "expected": [2]}
  ]
}
