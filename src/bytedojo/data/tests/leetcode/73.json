{
  "problem_id": 73,
  "title": "Set Matrix Zeroes",
  "difficulty": "Medium",
  "tests": [
    {"input": [[[1, 1, 1], [1, 0, 1], [1, 1, 1]]], "expected": [[1, 0, 1], [0, 0, 0], [1, 0, 1]]},
    {"input": [[[0, 1, 2, 0], [3, 4, 5, 2], [1, 3, 1, 5]]], "expected": [[0, 0, 0, 0], [0, 4, 5, 0], [0, 3, 1, 0]]},
    {"input": [[[1]]], "expected": [[1]]},
    {"input": [[[0]]], "expected": [[0]]},
    {"input": [[[1, 0]]], "expected": [[0, 0]]},
    {"input": [[[1], [0]]], "expected": [[0], [0]]},
    {"input": [[[1, 2, 3], [4, 5, 6]]], "expected": [[1, 2, 3], [4, 5, 6]]},
    {"input": [[[0, 0, 0], [0, 0, 0]]], "expected": [[0, 0, 0], [0, 0, 0]]},
    {"input": [[[1, 1, 1], [1, 1, 1], [1, 1, 1]]], "expected": [[1, 1, 1], [1, 1, 1], [1, 1, 1]]},
    {"input": [[[0, 1, 1], [1, 1, 1], [1, 1, 0]]], "expected": [[0, 0, 0], [0, 1, 0], [0, 0, 0]]},
    {"input": [[[1, 2, 3, 4], [5, 0, 7, 8], [9, 10, 11, 12], [13, 14, 15, 0]]], "expected": [[1, 0, 3, 0], [0, 0, 0, 0], [9, 0, 11, 0], [0, 0, 0, 0]]},
    {"input": [[[-1, 0, 3], [-2, 5, 6]]], "expected": [[0, 0, 0], [-2, 0, 6]]},
    {"input": [[[1, 0, 3]]], "expected": [[0, 0, 0]]},
    {"input": [[[1], [0], [3]]], "expected": [[0], [0], [0]]},
    {"input": [[[1, 2], [3, 0]]], "expected": [[1, 0], [0, 0]]}
  ]
}
