  "problem_id": 49,
  "title": "Group Anagrams",
  "difficulty": "Medium",
  "tests": [
    {"input": [["eat", "tea", "tan", "ate", "nat", "bat"]], "expected": [["bat"], ["nat", "tan"], ["ate", "eat", "tea"]]},
    {"input": [[""]], "expected": [[""]]},
    {"input": [["a"]], "expected": [["a"]]},
    {"input": [["", ""]], "expected": [["", ""]]},
    {"input": [["abc", "bca", "cab", "xyz", "zyx"]], "expected": [["abc", "bca", "cab"], ["xyz", "zyx"]]},
    {"input": [["listen", "silent", "enlist"]], "expected": [["listen", "silent", "enlist"]]},
    {"input": [["abc", "def", "ghi"]], "expected": [["abc"], ["def"], ["ghi"]]},
    {"input": [["a", "b", "c", "a"]], "expected": [["a", "a"], ["b"], ["c"]]},
    {"input": [["aa", "aa", "aa"]], "expected": [["aa", "aa", "aa"]]},
    {"input": [["abc", "cba", "bac", "def", "fed"]], "expected": [["abc", "cba", "bac"], ["def", "fed"]]},
    {"input": [["cat", "dog", "tac", "god", "act"]], "expected": [["cat", "tac", "act"], ["dog", "god"]]},
    {"input": [["ab", "ba", "abc", "cba"]], "expected": [["ab", "ba"], ["abc", "cba"]]},
    {"input": [["zzz", "zzz"]], "expected": [["zzz", "zzz"]]},
    {"input": [["aaa", "aab", "aba", "baa"]], "expected": [["aaa"], ["aab", "aba", "baa"]]},
    {"input": [["12", "21", "ab", "ba"]], "expected": [["12", "21"], ["ab", "ba"]]}
  ]
