{
  "problem_id": 23,
  "title": "Merge k Sorted Lists",
  "difficulty": "Hard",
  "tests": [
    {"input": [[[1, 4, 5], [1, 3, 4], [2, 6]]], "expected": [1, 1, 2, 3, 4, 4, 5, 6]},
    {"input": [[]], "expected": []},
    {"input": [[[]]],  "expected": []},
    {"input": [[[1]]], "expected": [1]},
    {"input": [[[1, 2, 3], [4, 5, 6], [7, 8, 9]]], "expected": [1, 2, 3, 4, 5, 6, 7, 8, 9]},
    {"input": [[[1], [2], [3], [4], [5]]], "expected": [1, 2, 3, 4, 5]},
    {"input": [[[5, 5, 5], [5, 5, 5]]], "expected": [5, 5, 5, 5, 5, 5]},
    {"input": [[[-1, 0, 1], [-2, 2]]], "expected": [-2, -1, 0, 1, 2]},
    {"input": [[[1, 2], [], [3, 4]]], "expected": [1, 2, 3, 4]},
    {"input": [[[1, 3, 5, 7], [2, 4, 6, 8]]], "expected": [1, 2, 3, 4, 5, 6, 7, 8]},
    {"input": [[[10], [1], [5]]], "expected": [1, 5, 10]},
    {"input": [[[], [], []]], "expected": []},
    {"input": [[[1, 1, 1], [1, 1, 1], [1, 1, 1]]], "expected": [1, 1, 1, 1, 1, 1, 1, 1, 1]},
    {"input": [[[-10, -5, 0], [-7, -3, 5], [-8, -2, 10]]], "expected": [-10, -8, -7, -5, -3, -2, 0, 5, 10]},
    {"input": [[[2, 6, 8], [3, 6, 7], [1, 3, 4]]], "expected": [1, 2, 3, 3, 4, 6, 6, 7, 8]}
  ]
}
