{
  "problem_id": 88,
  "title": "Merge Sorted Array",
  "difficulty": "Easy",
  "tests": [
    {"input": [[1, 2, 3, 0, 0, 0], 3, [2, 5, 6], 3], "expected": [1, 2, 2, 3, 5, 6]},
    {"input": [[1], 1, [], 0], "expected": [1]},
    {"input": [[0], 0, [1], 1], "expected": [1]},
    {"input": [[2, 0], 1, [1], 1], "expected": [1, 2]},
    {"input": [[4, 5, 6, 0, 0, 0], 3, [1, 2, 3], 3], "expected": [1, 2, 3, 4, 5, 6]},
    {"input": [[1, 2, 4, 5, 6, 0], 5, [3], 1], "expected": [1, 2, 3, 4, 5, 6]},
    {"input": [[0, 0, 0], 0, [1, 2, 3], 3], "expected": [1, 2, 3]},
    {"input": [[1, 2, 3], 3, [], 0], "expected": [1, 2, 3]},
    {"input": [[4, 0, 0, 0, 0, 0], 1, [1, 2, 3, 5, 6], 5], "expected": [1, 2, 3, 4, 5, 6]},
    {"input": [[1, 2, 3, 0, 0, 0], 3, [4, 5, 6], 3], "expected": [1, 2, 3, 4, 5, 6]},
    {"input": [[-1, 0, 0, 3, 3, 3, 0, 0, 0], 6, [1, 2, 2], 3], "expected": [-1, 0, 0, 1, 2, 2, 3, 3, 3]},
    {"input": [[0, 0, 3, 0, 0, 0, 0, 0, 0], 3, [-1, 1, 1, 1, 2, 3], 6], "expected": [-1, 0, 0, 1, 1, 1, 2, 3, 3]},
    {"input": [[1, 1, 1, 0, 0, 0], 3, [2, 2, 2], 3], "expected": [1, 1, 1, 2, 2, 2]},
    {"input": [[-1, 0, 1, 0, 0, 0], 3, [-1, 0, 2], 3], "expected": [-1, -1, 0, 0, 1, 2]},
    {"input": [[1, 0], 1, [2], 1], "expected": [1, 2]}
  ]
}
