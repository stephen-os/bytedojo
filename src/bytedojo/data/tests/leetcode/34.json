{
  "problem_id": 34,
  "title": "Find First and Last Position of Element in Sorted Array",
  "difficulty": "Medium",
  "tests": [
    {"input": [[5, 7, 7, 8, 8, 10], 8], "expected": [3, 4]},
    {"input": [[5, 7, 7, 8, 8, 10], 6], "expected": [-1, -1]},
    {"input": [[], 0], "expected": [-1, -1]},
    {"input": [[1], 1], "expected": [0, 0]},
    {"input": [[1], 0], "expected": [-1, -1]},
    {"input": [[2, 2], 2], "expected": [0, 1]},
    {"input": [[1, 2, 3], 2], "expected": [1, 1]},
    {"input": [[1, 1, 1, 1, 1], 1], "expected": [0, 4]},
    {"input": [[1, 2, 2, 2, 3], 2], "expected": [1, 3]},
    {"input": [[1, 2, 3, 4, 5], 1], "expected": [0, 0]},
    {"input": [[1, 2, 3, 4, 5], 5], "expected": [4, 4]},
    {"input": [[1, 1, 2, 2, 3, 3, 4, 4], 3], "expected": [4, 5]},
    {"input": [[0, 0, 0, 1, 2, 3], 0], "expected": [0, 2]},
    {"input": [[1, 3, 5, 7, 9], 6], "expected": [-1, -1]},
    {"input": [[2, 2, 2, 2, 2, 2, 2, 2], 2], "expected": [0, 7]}
  ]
}
