{
  "problem_id": 15,
  "title": "3Sum",
  "difficulty": "Medium",
  "tests": [
    {"input": [[-1, 0, 1, 2, -1, -4]], "expected": [[-1, -1, 2], [-1, 0, 1]]},
    {"input": [[0, 1, 1]], "expected": []},
    {"input": [[0, 0, 0]], "expected": [[0, 0, 0]]},
    {"input": [[-2, 0, 1, 1, 2]], "expected": [[-2, 0, 2], [-2, 1, 1]]},
    {"input": [[]], "expected": []},
    {"input": [[0]], "expected": []},
    {"input": [[1, 2, -2, -1]], "expected": []},
    {"input": [[-1, 0, 1]], "expected": [[-1, 0, 1]]},
    {"input": [[-4, -2, -2, -2, 0, 1, 2, 2, 2, 3, 3, 4, 4, 6, 6]], "expected": [[-4, -2, 6], [-4, 0, 4], [-4, 1, 3], [-4, 2, 2], [-2, -2, 4], [-2, 0, 2]]},
    {"input": [[3, 0, -2, -1, 1, 2]], "expected": [[-2, -1, 3], [-2, 0, 2], [-1, 0, 1]]},
    {"input": [[0, 0, 0, 0]], "expected": [[0, 0, 0]]},
    {"input": [[-1, -1, 2]], "expected": [[-1, -1, 2]]},
    {"input": [[-2, 0, 0, 2, 2]], "expected": [[-2, 0, 2]]},
    {"input": [[1, 1, -2]], "expected": [[-2, 1, 1]]},
    {"input": [[1, -1, -1, 0]], "expected": [[-1, 0, 1]]}
  ]
}
