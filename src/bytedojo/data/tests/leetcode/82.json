{
  "problem_id": 82,
  "title": "Remove Duplicates from Sorted List II",
  "difficulty": "Medium",
  "tests": [
    {"input": [[1, 2, 3, 3, 4, 4, 5]], "expected": [1, 2, 5]},
    {"input": [[1, 1, 1, 2, 3]], "expected": [2, 3]},
    {"input": [[]], "expected": []},
    {"input": [[1]], "expected": [1]},
    {"input": [[1, 1]], "expected": []},
    {"input": [[1, 2]], "expected": [1, 2]},
    {"input": [[1, 1, 2]], "expected": [2]},
    {"input": [[1, 2, 2]], "expected": [1]},
    {"input": [[1, 1, 2, 2]], "expected": []},
    {"input": [[1, 2, 3, 4, 5]], "expected": [1, 2, 3, 4, 5]},
    {"input": [[1, 1, 1, 1, 1]], "expected": []},
    {"input": [[1, 2, 2, 3, 3, 4, 5]], "expected": [1, 4, 5]},
    {"input": [[1, 1, 2, 3, 3]], "expected": [2]},
    {"input": [[1, 2, 3, 3, 3, 4, 4, 5, 5]], "expected": [1, 2]},
    {"input": [[-3, -3, -2, -1, -1, 0, 1]], "expected": [-2, 0, 1]}
  ]
}
