{
  "problem_id": 24,
  "title": "Swap Nodes in Pairs",
  "difficulty": "Medium",
  "tests": [
    {"input": [[1, 2, 3, 4]], "expected": [2, 1, 4, 3]},
    {"input": [[]], "expected": []},
    {"input": [[1]], "expected": [1]},
    {"input": [[1, 2]], "expected": [2, 1]},
    {"input": [[1, 2, 3]], "expected": [2, 1, 3]},
    {"input": [[1, 2, 3, 4, 5]], "expected": [2, 1, 4, 3, 5]},
    {"input": [[1, 2, 3, 4, 5, 6]], "expected": [2, 1, 4, 3, 6, 5]},
    {"input": [[1, 2, 3, 4, 5, 6, 7]], "expected": [2, 1, 4, 3, 6, 5, 7]},
    {"input": [[1, 2, 3, 4, 5, 6, 7, 8]], "expected": [2, 1, 4, 3, 6, 5, 8, 7]},
    {"input": [[10, 20]], "expected": [20, 10]},
    {"input": [[5, 10, 15, 20]], "expected": [10, 5, 20, 15]},
    {"input": [[100]], "expected": [100]},
    {"input": [[-1, -2, -3, -4]], "expected": [-2, -1, -4, -3]},
    {"input": [[0, 0, 0, 0]], "expected": [0, 0, 0, 0]},
    {"input": [[1, 1, 2, 2, 3, 3]], "expected": [1, 1, 2, 2, 3, 3]}
  ]
}
