{
  "problem_id": 18,
  "title": "4Sum",
  "difficulty": "Medium",
  "tests": [
    {"input": [[1, 0, -1, 0, -2, 2], 0], "expected": [[-2, -1, 1, 2], [-2, 0, 0, 2], [-1, 0, 0, 1]]},
    {"input": [[2, 2, 2, 2, 2], 8], "expected": [[2, 2, 2, 2]]},
    {"input": [[], 0], "expected": []},
    {"input": [[0], 0], "expected": []},
    {"input": [[0, 0, 0, 0], 0], "expected": [[0, 0, 0, 0]]},
    {"input": [[-3, -2, -1, 0, 0, 1, 2, 3], 0], "expected": [[-3, -2, 2, 3], [-3, -1, 1, 3], [-3, 0, 0, 3], [-3, 0, 1, 2], [-2, -1, 0, 3], [-2, -1, 1, 2], [-2, 0, 0, 2], [-1, 0, 0, 1]]},
    {"input": [[1, -2, -5, -4, -3, 3, 3, 5], -11], "expected": [[-5, -4, -3, 1]]},
    {"input": [[1, 0, -1, 0, -2, 2], 2], "expected": [[-1, 0, 1, 2]]},
    {"input": [[-1, 0, 1, 2, -1, -4], -1], "expected": [[-4, 0, 1, 2], [-1, -1, 0, 1]]},
    {"input": [[1, 1, 1, 1, 1], 4], "expected": [[1, 1, 1, 1]]},
    {"input": [[-5, 5, 4, -3, 0, 0, 4, -2], 4], "expected": [[-5, 0, 4, 5], [-3, -2, 4, 5]]},
    {"input": [[0, 0, 0, 0, 0], 0], "expected": [[0, 0, 0, 0]]},
    {"input": [[1, 2, 3, 4, 5], 10], "expected": [[1, 2, 3, 4]]},
    {"input": [[-1, -1, -1, 1, 1, 1], 0], "expected": [[-1, -1, 1, 1]]},
    {"input": [[5, 5, 3, 5, 1, -5, 1, -2], 4], "expected": [[-5, 1, 3, 5]]}
  ]
}
