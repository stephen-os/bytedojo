{
  "problem_id": 21,
  "title": "Merge Two Sorted Lists",
  "difficulty": "Easy",
  "tests": [
    {"input": [[1, 2, 4], [1, 3, 4]], "expected": [1, 1, 2, 3, 4, 4]},
    {"input": [[], []], "expected": []},
    {"input": [[], [0]], "expected": [0]},
    {"input": [[1], []], "expected": [1]},
    {"input": [[1, 3, 5], [2, 4, 6]], "expected": [1, 2, 3, 4, 5, 6]},
    {"input": [[5], [1, 2, 4]], "expected": [1, 2, 4, 5]},
    {"input": [[1, 2, 3], [4, 5, 6]], "expected": [1, 2, 3, 4, 5, 6]},
    {"input": [[4, 5, 6], [1, 2, 3]], "expected": [1, 2, 3, 4, 5, 6]},
    {"input": [[1], [1]], "expected": [1, 1]},
    {"input": [[2, 2, 2], [2, 2, 2]], "expected": [2, 2, 2, 2, 2, 2]},
    {"input": [[1, 5, 10], [2, 3, 15]], "expected": [1, 2, 3, 5, 10, 15]},
    {"input": [[-5, -3, -1], [-4, -2, 0]], "expected": [-5, -4, -3, -2, -1, 0]},
    {"input": [[0], [0]], "expected": [0, 0]},
    {"input": [[1, 1, 1], [2, 2, 2]], "expected": [1, 1, 1, 2, 2, 2]},
    {"input": [[10, 20, 30], [5, 15, 25, 35]], "expected": [5, 10, 15, 20, 25, 30, 35]}
  ]
}
