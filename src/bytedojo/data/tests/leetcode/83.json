{
  "problem_id": 83,
  "title": "Remove Duplicates from Sorted List",
  "difficulty": "Easy",
  "tests": [
    {"input": [[1, 1, 2]], "expected": [1, 2]},
    {"input": [[1, 1, 2, 3, 3]], "expected": [1, 2, 3]},
    {"input": [[]], "expected": []},
    {"input": [[1]], "expected": [1]},
    {"input": [[1, 1]], "expected": [1]},
    {"input": [[1, 2]], "expected": [1, 2]},
    {"input": [[1, 1, 1]], "expected": [1]},
    {"input": [[1, 1, 1, 2, 2, 2, 3, 3, 3]], "expected": [1, 2, 3]},
    {"input": [[1, 2, 3, 4, 5]], "expected": [1, 2, 3, 4, 5]},
    {"input": [[0, 0, 0, 0, 0]], "expected": [0]},
    {"input": [[-1, 0, 0, 0, 1]], "expected": [-1, 0, 1]},
    {"input": [[1, 1, 2, 2]], "expected": [1, 2]},
    {"input": [[1, 2, 2, 3]], "expected": [1, 2, 3]},
    {"input": [[1, 1, 1, 1, 1, 1, 1, 2]], "expected": [1, 2]},
    {"input": [[-3, -1, -1, 0, 0, 0, 0, 0, 2]], "expected": [-3, -1, 0, 2]}
  ]
}
