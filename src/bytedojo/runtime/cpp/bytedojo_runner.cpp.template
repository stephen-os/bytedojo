// ============================================================================
// main()
// ============================================================================

int main() {
    using namespace bj;
    try {
        string content = read_file("cases.json");
        Json bundle = parse_json(content);
        const auto& cases = bundle.at("cases").as_arr();

        vector<CaseResult> results;
        results.reserve(cases.size());
        for (const auto& c : cases) {
            int64_t case_id = c.at("case_id").as_int();
            const Json& input = c.at("input");
            const Json& expected = c.at("expected");
            try {
                results.push_back(run_case(case_id, input, expected));
            } catch (const std::exception& e) {
                CaseResult r;
                r.case_id = case_id;
                r.passed = false;
                r.error = string(typeid(e).name()) + ": " + e.what();
                results.push_back(std::move(r));
            }
        }

        emit_results(results);
        return 0;
    } catch (const std::exception& e) {
        // Catastrophic failure — emit a single case-0 envelope so the caller
        // still gets a well-formed payload.
        CaseResult r;
        r.case_id = 0;
        r.passed = false;
        r.error = string("runner crash: ") + e.what();
        emit_results({r});
        return 1;
    }
}
