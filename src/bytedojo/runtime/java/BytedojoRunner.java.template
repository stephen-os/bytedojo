/*
 * Universal Java test runner for ByteDojo.
 *
 * Standalone — no substitution at test time. TestService copies this
 * file into the build dir alongside the user's solution.java and any
 * sibling node-class files (TreeNode.java / ListNode.java), then
 * compiles all of them together (`javac *.java`) and launches
 * `java BytedojoRunner`. Reads cases.json from the cwd, dispatches
 * each case through reflection, emits a sentinel-wrapped JSON envelope.
 *
 * Solution / TreeNode / ListNode access is reflective so the runner
 * compiles cleanly even when the user's solution doesn't declare
 * those classes (primitive-only problems never resolve them at
 * runtime; the lookup only fires for cases that need them).
 */

import java.io.IOException;
import java.lang.reflect.Array;
import java.lang.reflect.Constructor;
import java.lang.reflect.Field;
import java.lang.reflect.InvocationTargetException;
import java.lang.reflect.Method;
import java.lang.reflect.Modifier;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayDeque;
import java.util.ArrayList;
import java.util.Deque;
import java.util.LinkedHashMap;
import java.util.LinkedList;
import java.util.List;
import java.util.Map;
import java.util.Objects;

public class BytedojoRunner {

    private static final String BEGIN = "<<<BYTEDOJO_RESULTS_BEGIN>>>";
    private static final String END = "<<<BYTEDOJO_RESULTS_END>>>";
    private static final double FLOAT_EPS = 1e-5;

    // Cached reflective handles for the user's TreeNode / ListNode (resolved
    // lazily — primitive-only problems never trigger Class.forName).
    private static Class<?> treeCls;
    private static Constructor<?> treeCtor;
    private static Field treeVal, treeLeft, treeRight;
    private static Class<?> listCls;
    private static Constructor<?> listCtor;
    private static Field listVal, listNext;

    public static void main(String[] args) {
        try {
            run();
        } catch (Throwable t) {
            // Catastrophic failure — emit a single case-0 error so the caller's
            // envelope parser still sees a well-formed payload.
            Map<String, Object> err = new LinkedHashMap<>();
            err.put("case", 0);
            err.put("passed", false);
            err.put("input", "");
            err.put("expected", "");
            err.put("actual", "");
            err.put("error", "runner crash: " + t.getClass().getSimpleName()
                    + ": " + safeMsg(t));
            List<Object> wrapper = new ArrayList<>();
            wrapper.add(err);
            emit(wrapper);
            System.exit(1);
        }
    }

    @SuppressWarnings("unchecked")
    private static void run() throws Exception {
        Path bundlePath = Paths.get(System.getProperty("user.dir"), "cases.json");
        String content = new String(Files.readAllBytes(bundlePath), StandardCharsets.UTF_8);
        Map<String, Object> bundle = (Map<String, Object>) Json.parse(content);

        String methodName = (String) bundle.get("method");
        Map<String, Object> signature = (Map<String, Object>) bundle.get("signature");
        List<Object> params = (List<Object>) signature.get("params");
        String returnType = (String) signature.get("returns");
        String comparison = bundle.containsKey("comparison")
                ? (String) bundle.get("comparison")
                : "exact";
        List<Object> cases = (List<Object>) bundle.get("cases");

        int n = params.size();
        String[] paramNames = new String[n];
        String[] paramCanon = new String[n];
        for (int i = 0; i < n; i++) {
            Map<String, Object> p = (Map<String, Object>) params.get(i);
            paramNames[i] = (String) p.get("name");
            paramCanon[i] = (String) p.get("type");
        }

        Class<?> solutionClass = Class.forName("Solution");
        Object solution = solutionClass.getDeclaredConstructor().newInstance();

        // Find the user's method by NAME — the bundle's canonical types may
        // diverge from the user's signature (e.g. bundle INT64 vs user int[]
        // for problems where most cases fit int32). We then narrow each
        // parsed value to the user's actual parameter type at the boundary.
        Method method = findMethodByName(solutionClass, methodName);
        Class<?>[] userParamTypes = method.getParameterTypes();

        List<Object> results = new ArrayList<>();
        for (Object caseObj : cases) {
            Map<String, Object> c = (Map<String, Object>) caseObj;
            long caseId = ((Number) c.get("case_id")).longValue();
            Map<String, Object> input = (Map<String, Object>) c.get("input");
            Object expectedRaw = c.get("expected");
            String inputStr = formatInput(input);

            Map<String, Object> result = new LinkedHashMap<>();
            result.put("case", caseId);
            result.put("input", inputStr);

            try {
                Object[] callArgs = new Object[n];
                for (int i = 0; i < n; i++) {
                    Object raw = parseValue(input.get(paramNames[i]), paramCanon[i]);
                    callArgs[i] = narrowTo(raw, userParamTypes[i]);
                }
                Object expected = parseValue(expectedRaw, returnType);

                Object actual = method.invoke(solution, callArgs);

                boolean passed = compare(actual, expected, returnType, comparison);
                result.put("passed", passed);
                result.put("expected", display(expected, returnType));
                result.put("actual", display(actual, returnType));
                result.put("error", null);
            } catch (Throwable e) {
                Throwable cause = (e instanceof InvocationTargetException)
                        ? e.getCause() : e;
                result.put("passed", false);
                result.put("expected", display(expectedRaw, returnType));
                result.put("actual", "");
                result.put("error", cause.getClass().getSimpleName() + ": " + safeMsg(cause));
            }
            results.add(result);
        }

        emit(results);
    }

    private static void emit(Object results) {
        System.out.println(BEGIN);
        System.out.println(Json.write(results));
        System.out.println(END);
    }

    private static String safeMsg(Throwable t) {
        String m = t.getMessage();
        return m == null ? "" : m;
    }

    // ------------------------------------------------------------------
    // Canonical-type → Java Class<?> mapping
    // ------------------------------------------------------------------

    private static Class<?> classFor(String t) throws ClassNotFoundException {
        switch (t) {
            case "INT32":           return int.class;
            case "INT64":           return long.class;
            case "FLOAT64":         return double.class;
            case "BOOL":            return boolean.class;
            case "CHAR":            return char.class;
            case "STRING":          return String.class;
            case "INT32_ARRAY":     return int[].class;
            case "INT64_ARRAY":     return long[].class;
            case "FLOAT64_ARRAY":   return double[].class;
            case "BOOL_ARRAY":      return boolean[].class;
            case "CHAR_ARRAY":      return char[].class;
            case "STRING_ARRAY":    return String[].class;
            case "INT32_MATRIX":    return int[][].class;
            case "INT64_MATRIX":    return long[][].class;
            case "CHAR_MATRIX":     return char[][].class;
            case "STRING_MATRIX":   return String[][].class;
            case "TREE_NODE":       return treeNodeClass();
            case "LIST_NODE":       return listNodeClass();
            case "LIST_NODE_ARRAY": return Array.newInstance(listNodeClass(), 0).getClass();
            default:
                throw new RuntimeException("Unknown canonical type: " + t);
        }
    }

    // ------------------------------------------------------------------
    // Method dispatch + arg narrowing
    // ------------------------------------------------------------------

    /** Find the first public method on `cls` matching `name`. Throws if absent. */
    private static Method findMethodByName(Class<?> cls, String name) throws NoSuchMethodException {
        for (Method m : cls.getDeclaredMethods()) {
            if (m.getName().equals(name) && Modifier.isPublic(m.getModifiers())) {
                return m;
            }
        }
        throw new NoSuchMethodException(
                "Solution class has no public method `" + name + "`"
        );
    }

    /**
     * Convert a bundle-parsed value to match the user's actual parameter type.
     *
     * The bundle's canonical types can be wider than the user's signature
     * (e.g. bundle INT64 with user int[]) because some cases in the corpus
     * exceed int32. When the bundle's value fits the narrower type, we
     * narrow silently. When it doesn't fit, we throw — the case surfaces
     * as a per-case error in the result envelope.
     */
    private static Object narrowTo(Object v, Class<?> target) {
        if (v == null) return null;
        if (target.isInstance(v)) return v;

        // Primitive scalars (Long → Integer / Short / Byte; Double → Float)
        if (v instanceof Long) {
            long lv = (Long) v;
            if (target == int.class || target == Integer.class) {
                if (lv < Integer.MIN_VALUE || lv > Integer.MAX_VALUE) {
                    throw new ArithmeticException("value " + lv + " does not fit int");
                }
                return (int) lv;
            }
            if (target == long.class || target == Long.class) {
                return lv;
            }
        }
        if (v instanceof Integer) {
            int iv = (Integer) v;
            if (target == long.class || target == Long.class) return (long) iv;
            if (target == int.class || target == Integer.class) return iv;
        }
        if (v instanceof Double) {
            double dv = (Double) v;
            if (target == double.class || target == Double.class) return dv;
            if (target == float.class || target == Float.class) return (float) dv;
        }

        // 1-D primitive array narrowing
        if (v instanceof long[]) {
            long[] src = (long[]) v;
            if (target == int[].class) {
                int[] dst = new int[src.length];
                for (int i = 0; i < src.length; i++) {
                    if (src[i] < Integer.MIN_VALUE || src[i] > Integer.MAX_VALUE) {
                        throw new ArithmeticException(
                                "value at index " + i + " (" + src[i] + ") does not fit int");
                    }
                    dst[i] = (int) src[i];
                }
                return dst;
            }
            if (target == long[].class) return src;
        }
        if (v instanceof int[]) {
            int[] src = (int[]) v;
            if (target == long[].class) {
                long[] dst = new long[src.length];
                for (int i = 0; i < src.length; i++) dst[i] = src[i];
                return dst;
            }
            if (target == int[].class) return src;
        }

        // 2-D primitive array narrowing
        if (v instanceof long[][]) {
            long[][] src = (long[][]) v;
            if (target == int[][].class) {
                int[][] dst = new int[src.length][];
                for (int i = 0; i < src.length; i++) {
                    dst[i] = (int[]) narrowTo(src[i], int[].class);
                }
                return dst;
            }
            if (target == long[][].class) return src;
        }
        if (v instanceof int[][]) {
            int[][] src = (int[][]) v;
            if (target == long[][].class) {
                long[][] dst = new long[src.length][];
                for (int i = 0; i < src.length; i++) {
                    int[] row = src[i];
                    long[] out = new long[row.length];
                    for (int j = 0; j < row.length; j++) out[j] = row[j];
                    dst[i] = out;
                }
                return dst;
            }
            if (target == int[][].class) return src;
        }

        return v;
    }

    // ------------------------------------------------------------------
    // TreeNode / ListNode reflective accessors (lazy, cached)
    // ------------------------------------------------------------------

    private static Class<?> treeNodeClass() throws ClassNotFoundException {
        if (treeCls == null) {
            try {
                treeCls = Class.forName("TreeNode");
            } catch (ClassNotFoundException e) {
                throw new ClassNotFoundException(
                        "Your solution.java does not define class TreeNode "
                        + "(required for this problem). Uncomment the TreeNode "
                        + "definition at the top of solution.java."
                );
            }
        }
        return treeCls;
    }

    private static Class<?> listNodeClass() throws ClassNotFoundException {
        if (listCls == null) {
            try {
                listCls = Class.forName("ListNode");
            } catch (ClassNotFoundException e) {
                throw new ClassNotFoundException(
                        "Your solution.java does not define class ListNode "
                        + "(required for this problem). Uncomment the ListNode "
                        + "definition at the top of solution.java."
                );
            }
        }
        return listCls;
    }

    private static Constructor<?> treeNodeCtor() throws Exception {
        if (treeCtor == null) {
            treeCtor = treeNodeClass().getDeclaredConstructor(int.class);
            treeCtor.setAccessible(true);
        }
        return treeCtor;
    }

    private static Constructor<?> listNodeCtor() throws Exception {
        if (listCtor == null) {
            listCtor = listNodeClass().getDeclaredConstructor(int.class);
            listCtor.setAccessible(true);
        }
        return listCtor;
    }

    private static Field treeNodeField(String name) throws Exception {
        Field f;
        switch (name) {
            case "val":
                if (treeVal == null) {
                    treeVal = treeNodeClass().getDeclaredField("val");
                    treeVal.setAccessible(true);
                }
                f = treeVal;
                break;
            case "left":
                if (treeLeft == null) {
                    treeLeft = treeNodeClass().getDeclaredField("left");
                    treeLeft.setAccessible(true);
                }
                f = treeLeft;
                break;
            case "right":
                if (treeRight == null) {
                    treeRight = treeNodeClass().getDeclaredField("right");
                    treeRight.setAccessible(true);
                }
                f = treeRight;
                break;
            default:
                throw new RuntimeException("Unknown TreeNode field: " + name);
        }
        return f;
    }

    private static Field listNodeField(String name) throws Exception {
        Field f;
        switch (name) {
            case "val":
                if (listVal == null) {
                    listVal = listNodeClass().getDeclaredField("val");
                    listVal.setAccessible(true);
                }
                f = listVal;
                break;
            case "next":
                if (listNext == null) {
                    listNext = listNodeClass().getDeclaredField("next");
                    listNext.setAccessible(true);
                }
                f = listNext;
                break;
            default:
                throw new RuntimeException("Unknown ListNode field: " + name);
        }
        return f;
    }

    // ------------------------------------------------------------------
    // Value parsing (JSON-loaded → native Java)
    // ------------------------------------------------------------------

    @SuppressWarnings("unchecked")
    private static Object parseValue(Object v, String t) throws Exception {
        if (v == null) {
            // Null reaches primitive params as null — invoke will fail with
            // NullPointerException which we catch as a per-case error.
            return null;
        }
        switch (t) {
            case "INT32":   return ((Number) v).intValue();
            case "INT64":   return ((Number) v).longValue();
            case "FLOAT64": return ((Number) v).doubleValue();
            case "BOOL":    return (Boolean) v;
            case "CHAR":    return ((String) v).charAt(0);
            case "STRING":  return v.toString();
            case "VOID":    return null;

            case "INT32_ARRAY":   return toIntArr((List<?>) v);
            case "INT64_ARRAY":   return toLongArr((List<?>) v);
            case "FLOAT64_ARRAY": return toDoubleArr((List<?>) v);
            case "BOOL_ARRAY":    return toBoolArr((List<?>) v);
            case "CHAR_ARRAY":    return toCharArr((List<?>) v);
            case "STRING_ARRAY":  return toStringArr((List<?>) v);

            case "INT32_MATRIX": {
                List<?> outer = (List<?>) v;
                int[][] r = new int[outer.size()][];
                for (int i = 0; i < r.length; i++) r[i] = toIntArr((List<?>) outer.get(i));
                return r;
            }
            case "INT64_MATRIX": {
                List<?> outer = (List<?>) v;
                long[][] r = new long[outer.size()][];
                for (int i = 0; i < r.length; i++) r[i] = toLongArr((List<?>) outer.get(i));
                return r;
            }
            case "CHAR_MATRIX": {
                List<?> outer = (List<?>) v;
                char[][] r = new char[outer.size()][];
                for (int i = 0; i < r.length; i++) r[i] = toCharArr((List<?>) outer.get(i));
                return r;
            }
            case "STRING_MATRIX": {
                List<?> outer = (List<?>) v;
                String[][] r = new String[outer.size()][];
                for (int i = 0; i < r.length; i++) r[i] = toStringArr((List<?>) outer.get(i));
                return r;
            }

            case "TREE_NODE": return buildTree((List<?>) v);
            case "LIST_NODE": return buildList((List<?>) v);
            case "LIST_NODE_ARRAY": {
                List<?> outer = (List<?>) v;
                Class<?> ln = listNodeClass();
                Object arr = Array.newInstance(ln, outer.size());
                for (int i = 0; i < outer.size(); i++) {
                    Array.set(arr, i, buildList((List<?>) outer.get(i)));
                }
                return arr;
            }
            default:
                throw new RuntimeException("Unknown canonical type: " + t);
        }
    }

    private static int[] toIntArr(List<?> a) {
        int[] r = new int[a.size()];
        for (int i = 0; i < r.length; i++) r[i] = ((Number) a.get(i)).intValue();
        return r;
    }

    private static long[] toLongArr(List<?> a) {
        long[] r = new long[a.size()];
        for (int i = 0; i < r.length; i++) r[i] = ((Number) a.get(i)).longValue();
        return r;
    }

    private static double[] toDoubleArr(List<?> a) {
        double[] r = new double[a.size()];
        for (int i = 0; i < r.length; i++) r[i] = ((Number) a.get(i)).doubleValue();
        return r;
    }

    private static boolean[] toBoolArr(List<?> a) {
        boolean[] r = new boolean[a.size()];
        for (int i = 0; i < r.length; i++) r[i] = (Boolean) a.get(i);
        return r;
    }

    private static char[] toCharArr(List<?> a) {
        char[] r = new char[a.size()];
        for (int i = 0; i < r.length; i++) r[i] = ((String) a.get(i)).charAt(0);
        return r;
    }

    private static String[] toStringArr(List<?> a) {
        String[] r = new String[a.size()];
        for (int i = 0; i < r.length; i++) r[i] = (String) a.get(i);
        return r;
    }

    // ------------------------------------------------------------------
    // Tree + linked-list construction / serialization (reflective)
    // ------------------------------------------------------------------

    private static Object buildTree(List<?> levelOrder) throws Exception {
        if (levelOrder == null || levelOrder.isEmpty()) return null;
        if (levelOrder.get(0) == null) return null;
        Constructor<?> ctor = treeNodeCtor();
        Field left = treeNodeField("left");
        Field right = treeNodeField("right");

        Object root = ctor.newInstance(((Number) levelOrder.get(0)).intValue());
        Deque<Object> queue = new ArrayDeque<>();
        queue.add(root);
        int i = 1;
        int n = levelOrder.size();
        while (!queue.isEmpty() && i < n) {
            Object node = queue.poll();
            if (i < n) {
                Object lv = levelOrder.get(i);
                if (lv != null) {
                    Object child = ctor.newInstance(((Number) lv).intValue());
                    left.set(node, child);
                    queue.add(child);
                }
                i++;
            }
            if (i < n) {
                Object rv = levelOrder.get(i);
                if (rv != null) {
                    Object child = ctor.newInstance(((Number) rv).intValue());
                    right.set(node, child);
                    queue.add(child);
                }
                i++;
            }
        }
        return root;
    }

    private static List<Object> serializeTree(Object root) throws Exception {
        List<Object> out = new ArrayList<>();
        if (root == null) return out;
        Field val = treeNodeField("val");
        Field left = treeNodeField("left");
        Field right = treeNodeField("right");

        // LinkedList allows nulls (ArrayDeque doesn't)
        LinkedList<Object> queue = new LinkedList<>();
        queue.add(root);
        while (!queue.isEmpty()) {
            Object node = queue.pollFirst();
            if (node == null) {
                out.add(null);
                continue;
            }
            out.add(((Number) val.get(node)).longValue());
            queue.addLast(left.get(node));
            queue.addLast(right.get(node));
        }
        while (!out.isEmpty() && out.get(out.size() - 1) == null) {
            out.remove(out.size() - 1);
        }
        return out;
    }

    private static Object buildList(List<?> flat) throws Exception {
        if (flat == null || flat.isEmpty()) return null;
        Constructor<?> ctor = listNodeCtor();
        Field next = listNodeField("next");

        Object head = ctor.newInstance(((Number) flat.get(0)).intValue());
        Object cur = head;
        for (int i = 1; i < flat.size(); i++) {
            Object node = ctor.newInstance(((Number) flat.get(i)).intValue());
            next.set(cur, node);
            cur = node;
        }
        return head;
    }

    private static List<Object> serializeList(Object head) throws Exception {
        List<Object> out = new ArrayList<>();
        if (head == null) return out;
        Field val = listNodeField("val");
        Field next = listNodeField("next");
        while (head != null) {
            out.add(((Number) val.get(head)).longValue());
            head = next.get(head);
        }
        return out;
    }

    private static List<Object> serializeListArray(Object arr) throws Exception {
        List<Object> out = new ArrayList<>();
        if (arr == null) return out;
        int n = Array.getLength(arr);
        for (int i = 0; i < n; i++) {
            out.add(serializeList(Array.get(arr, i)));
        }
        return out;
    }

    // ------------------------------------------------------------------
    // Comparison
    // ------------------------------------------------------------------

    private static boolean compare(Object actual, Object expected,
                                   String returnType, String comparison) throws Exception {
        if ("VOID".equals(returnType)) return true;
        if ("TREE_NODE".equals(returnType)) {
            return serializeTree(actual).equals(serializeTree(expected));
        }
        if ("LIST_NODE".equals(returnType)) {
            return serializeList(actual).equals(serializeList(expected));
        }
        if ("LIST_NODE_ARRAY".equals(returnType)) {
            return serializeListArray(actual).equals(serializeListArray(expected));
        }
        if ("FLOAT64".equals(returnType)) return floatEqual(actual, expected);
        if ("FLOAT64_ARRAY".equals(returnType)) return floatArrayEqual(actual, expected);

        Object a = toListForm(actual);
        Object e = toListForm(expected);
        if ("unordered_all".equals(comparison)) {
            a = sortRecursive(a);
            e = sortRecursive(e);
        }
        return Objects.equals(a, e);
    }

    /** Convert any Java array (primitive or Object) to a nested List, normalizing
     * numeric width so equals() works across int vs long. */
    private static Object toListForm(Object v) {
        if (v == null) return null;
        if (v instanceof int[]) {
            List<Object> r = new ArrayList<>();
            for (int x : (int[]) v) r.add((long) x);
            return r;
        }
        if (v instanceof long[]) {
            List<Object> r = new ArrayList<>();
            for (long x : (long[]) v) r.add(x);
            return r;
        }
        if (v instanceof double[]) {
            List<Object> r = new ArrayList<>();
            for (double x : (double[]) v) r.add(x);
            return r;
        }
        if (v instanceof boolean[]) {
            List<Object> r = new ArrayList<>();
            for (boolean x : (boolean[]) v) r.add(x);
            return r;
        }
        if (v instanceof char[]) {
            List<Object> r = new ArrayList<>();
            for (char x : (char[]) v) r.add(String.valueOf(x));
            return r;
        }
        if (v instanceof int[][]) {
            List<Object> r = new ArrayList<>();
            for (int[] row : (int[][]) v) r.add(toListForm(row));
            return r;
        }
        if (v instanceof long[][]) {
            List<Object> r = new ArrayList<>();
            for (long[] row : (long[][]) v) r.add(toListForm(row));
            return r;
        }
        if (v instanceof char[][]) {
            List<Object> r = new ArrayList<>();
            for (char[] row : (char[][]) v) r.add(toListForm(row));
            return r;
        }
        if (v instanceof String[][]) {
            List<Object> r = new ArrayList<>();
            for (String[] row : (String[][]) v) r.add(toListForm(row));
            return r;
        }
        if (v instanceof Object[]) {
            List<Object> r = new ArrayList<>();
            for (Object x : (Object[]) v) r.add(toListForm(x));
            return r;
        }
        if (v instanceof List) {
            List<Object> r = new ArrayList<>();
            for (Object x : (List<?>) v) r.add(toListForm(x));
            return r;
        }
        // Unify int + long both to Long for equals()
        if (v instanceof Integer) return ((Integer) v).longValue();
        if (v instanceof Character) return String.valueOf(((Character) v).charValue());
        return v;
    }

    @SuppressWarnings("unchecked")
    private static Object sortRecursive(Object v) {
        if (!(v instanceof List)) return v;
        List<Object> in = (List<Object>) v;
        List<Object> sorted = new ArrayList<>(in.size());
        for (Object item : in) sorted.add(sortRecursive(item));
        sorted.sort(BytedojoRunner::cmp);
        return sorted;
    }

    @SuppressWarnings({"unchecked", "rawtypes"})
    private static int cmp(Object a, Object b) {
        if (a == null && b == null) return 0;
        if (a == null) return -1;
        if (b == null) return 1;
        if (a instanceof List && b instanceof List) {
            List<?> la = (List<?>) a;
            List<?> lb = (List<?>) b;
            int min = Math.min(la.size(), lb.size());
            for (int i = 0; i < min; i++) {
                int c = cmp(la.get(i), lb.get(i));
                if (c != 0) return c;
            }
            return Integer.compare(la.size(), lb.size());
        }
        if (a instanceof Number && b instanceof Number) {
            return Double.compare(((Number) a).doubleValue(), ((Number) b).doubleValue());
        }
        if (a instanceof Comparable && a.getClass() == b.getClass()) {
            return ((Comparable) a).compareTo(b);
        }
        return a.toString().compareTo(b.toString());
    }

    private static boolean floatEqual(Object a, Object b) {
        if (a == null && b == null) return true;
        if (a == null || b == null) return false;
        double da = ((Number) a).doubleValue();
        double db = ((Number) b).doubleValue();
        if (Double.isNaN(da) && Double.isNaN(db)) return true;
        return Math.abs(da - db) <= FLOAT_EPS;
    }

    private static boolean floatArrayEqual(Object a, Object b) {
        if (a == null && b == null) return true;
        if (a == null || b == null) return false;
        double[] da = toDoubleArrayCoerce(a);
        double[] db = toDoubleArrayCoerce(b);
        if (da.length != db.length) return false;
        for (int i = 0; i < da.length; i++) {
            if (Double.isNaN(da[i]) && Double.isNaN(db[i])) continue;
            if (Math.abs(da[i] - db[i]) > FLOAT_EPS) return false;
        }
        return true;
    }

    private static double[] toDoubleArrayCoerce(Object v) {
        if (v instanceof double[]) return (double[]) v;
        if (v instanceof List) {
            List<?> l = (List<?>) v;
            double[] r = new double[l.size()];
            for (int i = 0; i < r.length; i++) r[i] = ((Number) l.get(i)).doubleValue();
            return r;
        }
        return new double[0];
    }

    // ------------------------------------------------------------------
    // Display (failure output)
    // ------------------------------------------------------------------

    private static String formatInput(Map<String, Object> input) {
        StringBuilder sb = new StringBuilder();
        boolean first = true;
        for (Map.Entry<String, Object> e : input.entrySet()) {
            if (!first) sb.append(", ");
            sb.append(e.getKey()).append(" = ").append(formatValueDisplay(e.getValue()));
            first = false;
        }
        return sb.toString();
    }

    private static String formatValueDisplay(Object v) {
        if (v == null) return "null";
        if (v instanceof Boolean) return ((Boolean) v) ? "true" : "false";
        if (v instanceof String) return "\"" + v + "\"";
        if (v instanceof List) {
            StringBuilder sb = new StringBuilder("[");
            boolean first = true;
            for (Object x : (List<?>) v) {
                if (!first) sb.append(", ");
                sb.append(formatValueDisplay(x));
                first = false;
            }
            sb.append("]");
            return sb.toString();
        }
        return v.toString();
    }

    private static String display(Object v, String returnType) throws Exception {
        if ("VOID".equals(returnType)) return "None";
        if (v == null) return "null";
        if ("TREE_NODE".equals(returnType)) return formatValueDisplay(serializeTree(v));
        if ("LIST_NODE".equals(returnType)) return formatValueDisplay(serializeList(v));
        if ("LIST_NODE_ARRAY".equals(returnType)) return formatValueDisplay(serializeListArray(v));
        return formatValueDisplay(toListForm(v));
    }

    // ==================================================================
    // Json — minimal recursive-descent parser + writer (zero deps).
    //
    // Parse output types:
    //   null  -> null
    //   true  -> Boolean.TRUE  / false -> Boolean.FALSE
    //   ints  -> Long (overflow falls back to Double)
    //   nums with . or exponent -> Double
    //   "s"   -> String
    //   [..]  -> ArrayList<Object>
    //   {..}  -> LinkedHashMap<String, Object>   (preserves insertion order)
    // ==================================================================

    private static final class Json {
        int pos;
        String src;

        static Object parse(String s) {
            Json j = new Json();
            j.src = s;
            j.pos = 0;
            j.skipWs();
            return j.parseValue();
        }

        private Object parseValue() {
            skipWs();
            char c = src.charAt(pos);
            if (c == '{') return parseObj();
            if (c == '[') return parseArr();
            if (c == '"') return parseStr();
            if (c == 't' || c == 'f') return parseBool();
            if (c == 'n') return parseNull();
            return parseNum();
        }

        private Map<String, Object> parseObj() {
            Map<String, Object> m = new LinkedHashMap<>();
            pos++; // {
            skipWs();
            if (src.charAt(pos) == '}') { pos++; return m; }
            while (true) {
                skipWs();
                String k = parseStr();
                skipWs();
                pos++; // :
                Object v = parseValue();
                m.put(k, v);
                skipWs();
                char c = src.charAt(pos);
                if (c == ',') { pos++; continue; }
                if (c == '}') { pos++; break; }
                throw new RuntimeException("Expected , or } at " + pos);
            }
            return m;
        }

        private List<Object> parseArr() {
            List<Object> a = new ArrayList<>();
            pos++; // [
            skipWs();
            if (src.charAt(pos) == ']') { pos++; return a; }
            while (true) {
                a.add(parseValue());
                skipWs();
                char c = src.charAt(pos);
                if (c == ',') { pos++; continue; }
                if (c == ']') { pos++; break; }
                throw new RuntimeException("Expected , or ] at " + pos);
            }
            return a;
        }

        private String parseStr() {
            StringBuilder sb = new StringBuilder();
            pos++; // "
            while (pos < src.length()) {
                char c = src.charAt(pos++);
                if (c == '"') return sb.toString();
                if (c == '\\') {
                    char esc = src.charAt(pos++);
                    switch (esc) {
                        case '"':  sb.append('"'); break;
                        case '\\': sb.append('\\'); break;
                        case '/':  sb.append('/'); break;
                        case 'n':  sb.append('\n'); break;
                        case 't':  sb.append('\t'); break;
                        case 'r':  sb.append('\r'); break;
                        case 'b':  sb.append('\b'); break;
                        case 'f':  sb.append('\f'); break;
                        case 'u': {
                            int code = Integer.parseInt(src.substring(pos, pos + 4), 16);
                            sb.append((char) code);
                            pos += 4;
                            break;
                        }
                        default: sb.append(esc);
                    }
                } else {
                    sb.append(c);
                }
            }
            throw new RuntimeException("Unterminated string");
        }

        private Boolean parseBool() {
            if (src.startsWith("true", pos))  { pos += 4; return Boolean.TRUE; }
            if (src.startsWith("false", pos)) { pos += 5; return Boolean.FALSE; }
            throw new RuntimeException("Expected boolean at " + pos);
        }

        private Object parseNull() {
            if (src.startsWith("null", pos)) { pos += 4; return null; }
            throw new RuntimeException("Expected null at " + pos);
        }

        private Object parseNum() {
            int start = pos;
            if (src.charAt(pos) == '-') pos++;
            boolean isFloat = false;
            while (pos < src.length()) {
                char c = src.charAt(pos);
                if (c == '.' || c == 'e' || c == 'E' || c == '+') { isFloat = true; pos++; }
                else if (Character.isDigit(c) || c == '-') pos++;
                else break;
            }
            String num = src.substring(start, pos);
            if (isFloat) return Double.parseDouble(num);
            try { return Long.parseLong(num); }
            catch (NumberFormatException e) { return Double.parseDouble(num); }
        }

        private void skipWs() {
            while (pos < src.length() && Character.isWhitespace(src.charAt(pos))) pos++;
        }

        // -------------------- writer --------------------

        static String write(Object v) {
            StringBuilder sb = new StringBuilder();
            writeValue(sb, v);
            return sb.toString();
        }

        private static void writeValue(StringBuilder sb, Object v) {
            if (v == null) { sb.append("null"); return; }
            if (v instanceof Boolean) { sb.append(v.toString()); return; }
            if (v instanceof Number) { sb.append(v.toString()); return; }
            if (v instanceof String) { writeString(sb, (String) v); return; }
            if (v instanceof List) {
                sb.append('[');
                boolean first = true;
                for (Object x : (List<?>) v) {
                    if (!first) sb.append(',');
                    writeValue(sb, x);
                    first = false;
                }
                sb.append(']');
                return;
            }
            if (v instanceof Map) {
                sb.append('{');
                boolean first = true;
                for (Map.Entry<?, ?> e : ((Map<?, ?>) v).entrySet()) {
                    if (!first) sb.append(',');
                    writeString(sb, e.getKey().toString());
                    sb.append(':');
                    writeValue(sb, e.getValue());
                    first = false;
                }
                sb.append('}');
                return;
            }
            writeString(sb, v.toString());
        }

        private static void writeString(StringBuilder sb, String s) {
            sb.append('"');
            for (int i = 0; i < s.length(); i++) {
                char c = s.charAt(i);
                switch (c) {
                    case '"':  sb.append("\\\""); break;
                    case '\\': sb.append("\\\\"); break;
                    case '\n': sb.append("\\n"); break;
                    case '\t': sb.append("\\t"); break;
                    case '\r': sb.append("\\r"); break;
                    case '\b': sb.append("\\b"); break;
                    case '\f': sb.append("\\f"); break;
                    default:
                        if (c < 0x20) sb.append(String.format("\\u%04x", (int) c));
                        else sb.append(c);
                }
            }
            sb.append('"');
        }
    }
}
